# Copy to .env (gitignored) next to docker-compose.yaml. docker compose reads it on the machine you run it
# from and passes it into the container; after a change run `docker compose up -d` (README.md).
# No secret belongs here: the device password lives on the Pi only (DETECTION.md, "Device account").

# collection: record training frames (DATA_COLLECTION.md)
# detection:  read plates and send them to the cloud (DETECTION.md)
EDGE_MODE=collection

# --- detection mode: the platform on AWS ---------------------------------------------------------------
# API Gateway of the environment (terraform output of infrastructure/envs/dev). Empty: no cloud.
API_BASE_URL=
# Cognito user pool region and the id of its public `device` app client. Empty: requests carry no token.
COGNITO_REGION=
COGNITO_CLIENT_ID=

# --- detection mode: development overrides (no token is sent to them) ---------------------------------
# A mock ingest, e.g. tools/mock_ingest.py: http://localhost:8200/api/v1/ingest/detections
INGEST_URL=
# A model server, e.g. tools/serve_models.py: http://localhost:8100/manifest.json
MODELS_MANIFEST_URL=
# Recorded frames instead of the camera, a directory inside the container (README.md, "Replaying frames").
REPLAY_DIR=
